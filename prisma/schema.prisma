generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}
enum Breed {
  Holstein
  Jersey
  Guernsey
  Ayrshire
  Brown_Swiss
  Milking_Shorthorn
  Crossbreed
  Other
}

enum Gender {
  Female
  Male
}

enum CattleStatus {
  Active
  Dry
  Pregnant
  Sold
  Deceased
}

enum GrowthStage {
  Calf
  Post_weaning_Calf
  Growing_Heifer
  Bred_Heifer
  Mature_Cow
}

enum AcquisitionType {
  Born_on_Farm
  Purchased
  Gifted
}

enum HealthStatus {
  Healthy
  Sick
  Recovering
}

enum HealthRecordType {
  Vaccination
  Treatment
  Deworming
  Disease
  Injury
  Surgery
  PregnancyCheck
  Other
}

enum BreedingMethod {
  Natural
  ArtificialInsemination
  EmbryoTransfer
}

enum PregnancyStatus {
  Open
  Pregnant
  Failed
  Calved
}
enum MilkingSession {
  Morning
  Afternoon
  Evening
}

enum MilkQualityGrade {
  A
  B
  C
}
enum FeedType {
  Hay
  Silage
  Concentrate
  Mineral
  Supplement
  Pasture
  Other
}

enum StockTransactionType {
  Purchase
  Consumption
  Adjustment
  Transfer
  Loss
}
model Cattle {
  id                 String   @id @default(uuid())

  tagNumber          String   @unique
  name               String

  breed              Breed

  dateOfBirth        DateTime

  gender             Gender @default(Female)

  status             CattleStatus @default(Active)

  stage              GrowthStage

  lactationNumber    Int      @default(0)

  weightKg           Float?

  acquisitionDate    DateTime?

  acquisitionType    AcquisitionType @default(Born_on_Farm)

  groupId            String?

  group CattleGroup? @relation(fields: [groupId], references: [id])

  photo              String?

  notes              String?

  active             Boolean  @default(true)

  healthRecords      HealthRecord[]

  breedingRecords BreedingRecord[]

  milkProductions MilkProduction[]

  feedConsumptions FeedConsumption[]

  createdAt          DateTime @default(now())

  updatedAt          DateTime @updatedAt
}
model CattleGroup {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  color       String?
  active      Boolean  @default(true)

  cattle      Cattle[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
model HealthRecord {

  id              String @id @default(uuid())

  cattleId        String

  cattle          Cattle @relation(fields:[cattleId],references:[id])

  type            HealthRecordType

  status          HealthStatus @default(Healthy)

  diagnosis       String?

  treatment       String?

  medicine        String?

  dosage          String?

  veterinarian    String?

  cost            Float?

  visitDate       DateTime

  nextVisit       DateTime?

  notes           String?

  createdAt       DateTime @default(now())

  updatedAt       DateTime @updatedAt
}
model User {
  id           String   @id @default(uuid())
  firstName    String
  lastName     String
  email        String   @unique
  password     String

  role         String   @default("ADMIN")
  active       Boolean  @default(true)

  refreshToken String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
model BreedingRecord {

  id                 String @id @default(uuid())

  cattleId           String

  cattle             Cattle @relation(fields:[cattleId],references:[id])

  breedingDate       DateTime

  method             BreedingMethod

  bullName           String?

  semenBatch         String?

  technician         String?

  expectedCalving    DateTime?

  actualCalving      DateTime?

  pregnancyStatus    PregnancyStatus @default(Open)

  calfTag            String?

  calfGender         Gender?

  notes              String?

  createdAt          DateTime @default(now())

  updatedAt          DateTime @updatedAt
}
model MilkProduction {

  id                  String @id @default(uuid())

  cattleId            String

  cattle              Cattle @relation(fields: [cattleId], references: [id])

  date                DateTime

  session             MilkingSession

  quantityLiters      Float

  milkUsedByCalves    Float? @default(0)

  fatPercentage       Float?

  proteinPercentage   Float?

  somaticCellCount    Int?

  qualityGrade        MilkQualityGrade @default(A)

  notes               String?

  createdAt           DateTime @default(now())

  updatedAt           DateTime @updatedAt
}
model FeedCategory {

  id          String   @id @default(uuid())

  name        String   @unique

  description String?

  createdAt   DateTime @default(now())

  updatedAt   DateTime @updatedAt

  feeds       FeedInventory[]
}
model FeedInventory {

  id                  String @id @default(uuid())

  categoryId          String

  category            FeedCategory @relation(fields:[categoryId], references:[id])

  name                String

  type                FeedType

  quantity            Float

  unit                String

  minimumStock        Float

  unitCost            Float?

  supplier            String?

  batchNumber         String?

  manufactureDate     DateTime?

  expiryDate          DateTime?

  storageLocation     String?

  notes               String?

  createdAt           DateTime @default(now())

  updatedAt           DateTime @updatedAt

  stockTransactions   FeedStockTransaction[]

  consumptions        FeedConsumption[]
}
model FeedStockTransaction {

  id               String @id @default(uuid())

  feedId           String

  feed             FeedInventory @relation(fields:[feedId], references:[id])

  transactionType  StockTransactionType

  quantity         Float

  transactionDate  DateTime

  reference        String?

  remarks          String?

  createdAt        DateTime @default(now())
}
model FeedConsumption {

  id               String @id @default(uuid())

  cattleId         String

  cattle           Cattle @relation(fields:[cattleId], references:[id])

  feedId           String

  feed             FeedInventory @relation(fields:[feedId], references:[id])

  feedingDate      DateTime

  quantity         Float

  session          MilkingSession

  remarks          String?

  createdAt        DateTime @default(now())
}
