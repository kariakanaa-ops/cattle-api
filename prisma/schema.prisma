generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum Breed {
  Holstein
  Jersey
  Guernsey
  Ayrshire
  Brown_Swiss
  Milking_Shorthorn
  Crossbreed
  Other
}

enum Gender {
  Female
  Male
}

enum CattleStatus {
  Active
  Dry
  Pregnant
  Sold
  Deceased
}

enum GrowthStage {
  Calf
  Post_weaning_Calf
  Growing_Heifer
  Bred_Heifer
  Mature_Cow
}

enum AcquisitionType {
  Born_on_Farm
  Purchased
  Gifted
}

enum HealthStatus {
  Healthy
  Sick
  Recovering
}

enum HealthRecordType {
  Vaccination
  Treatment
  Deworming
  Disease
  Injury
  Surgery
  PregnancyCheck
  Other
}

enum BreedingMethod {
  Natural
  ArtificialInsemination
  EmbryoTransfer
}

enum PregnancyStatus {
  Open
  Pregnant
  Failed
  Calved
}

enum MilkingSession {
  Morning
  Afternoon
  Evening
}

enum MilkQualityGrade {
  A
  B
  C
}

enum FeedType {
  Hay
  Silage
  Concentrate
  Mineral
  Supplement
  Pasture
  Other
}

enum StockTransactionType {
  Purchase
  Consumption
  Adjustment
  Transfer
  Loss
}

enum VendorCategory {
  Feed
  Medicine
  Equipment
  Services
  General
}

enum PaymentTerms {
  Cash
  Net7
  Net14
  Net30
  Net60
}

enum InventoryCategory {
  Feed
  Medicine
  Equipment
  Supplies
}

enum StockAdjustmentType {
  Purchase
  Consumption
  Waste
  Transfer
  Adjustment
}

enum TransactionType {
  Income
  Expense
}

enum PaymentMethod {
  Cash
  MobileMoney
  BankTransfer
  Cheque
  Credit
}

enum UserRole {
  Admin
  Manager
  Veterinarian
  Accountant
  FarmWorker
}

enum DocumentType {
  Photo
  PDF
  Word
  Excel
  Image
  Video
  Other
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
}

enum NotificationType {
  Info
  Warning
  Critical
}

enum NotificationStatus {
  Unread
  Read
}

model Cattle {
  id String @id @default(uuid())

  tagNumber String @unique
  name      String

  breed Breed

  dateOfBirth DateTime

  gender Gender @default(Female)

  status CattleStatus @default(Active)

  stage GrowthStage

  lactationNumber Int @default(0)

  weightKg Float?

  acquisitionDate DateTime?

  acquisitionType AcquisitionType @default(Born_on_Farm)

  groupId String?

  group CattleGroup? @relation(fields: [groupId], references: [id])

  photo String?

  notes String?

  active Boolean @default(true)

  healthRecords HealthRecord[]

  breedingRecords BreedingRecord[]

  milkProductions MilkProduction[]

  transactions Transaction[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model CattleGroup {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  color       String?
  active      Boolean @default(true)

  cattle Cattle[]

  consumptions ConsumptionRecord[]

  feedRatios FeedRatio[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HealthRecord {
  id String @id @default(uuid())

  cattleId String

  cattle Cattle @relation(fields: [cattleId], references: [id])

  type HealthRecordType

  status HealthStatus @default(Healthy)

  diagnosis String?

  treatment String?

  medicine String?

  dosage String?

  veterinarian String?

  cost Float?

  visitDate DateTime

  nextVisit DateTime?

  notes String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model User {
  id        String @id @default(uuid())
  firstName String
  lastName  String
  email     String @unique
  password  String

  role   UserRole @default(Admin)
  active Boolean  @default(true)

  refreshToken String?

  auditTrails AuditTrail[]

  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BreedingRecord {
  id String @id @default(uuid())

  cattleId String

  cattle Cattle @relation(fields: [cattleId], references: [id])

  breedingDate DateTime

  method BreedingMethod

  bullName String?

  semenBatch String?

  technician String?

  expectedCalving DateTime?

  actualCalving DateTime?

  pregnancyStatus PregnancyStatus @default(Open)

  calfTag String?

  calfGender Gender?

  notes String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model MilkProduction {
  id String @id @default(uuid())

  cattleId String

  cattle Cattle @relation(fields: [cattleId], references: [id])

  date DateTime

  session MilkingSession

  quantityLiters Float

  milkUsedByCalves Float? @default(0)

  fatPercentage Float?

  proteinPercentage Float?

  somaticCellCount Int?

  qualityGrade MilkQualityGrade @default(A)

  notes String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Inventory {
  id String @id @default(uuid())

  itemName String

  category InventoryCategory

  quantity Float

  unit String

  reorderLevel Float

  unitCost Float

  vendorId String?

  vendor Vendor? @relation(fields: [vendorId], references: [id])

  lastRestocked DateTime?

  adjustments StockAdjustment[]

  consumptions ConsumptionRecord[]

  feedRatioComponents FeedRatioComponent[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Vendor {
  id String @id @default(uuid())

  name String

  contactPerson String?

  email String?

  phone String?

  category VendorCategory

  paymentTerms PaymentTerms

  address String?

  notes String?

  inventory Inventory[]

  transactions Transaction[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model StockAdjustment {
  id String @id @default(uuid())

  inventoryId String

  inventory Inventory @relation(fields: [inventoryId], references: [id])

  adjustmentType StockAdjustmentType

  quantity Float

  adjustmentDate DateTime

  reason String?

  referenceNumber String?

  createdBy String?

  createdAt DateTime @default(now())
}

model ConsumptionRecord {
  id String @id @default(uuid())

  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id])

  groupId String
  group   CattleGroup @relation(fields: [groupId], references: [id])

  quantity Float

  feedingDate DateTime

  notes String?

  recordedBy String?

  createdAt DateTime @default(now())
}

model FeedRatio {
  id String @id @default(uuid())

  name String

  groupId String

  group CattleGroup @relation(fields: [groupId], references: [id])

  notes String?

  components FeedRatioComponent[]

  schedules ScheduledFeedRatio[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model FeedRatioComponent {
  id String @id @default(uuid())

  feedRatioId String

  feedRatio FeedRatio @relation(fields: [feedRatioId], references: [id], onDelete: Cascade)

  inventoryId String

  inventory Inventory @relation(fields: [inventoryId], references: [id])

  quantity Float

  unit String

  createdAt DateTime @default(now())
}

model ScheduledFeedRatio {
  id String @id @default(uuid())

  feedRatioId String

  feedRatio FeedRatio @relation(fields: [feedRatioId], references: [id], onDelete: Cascade)

  scheduledTime String

  monday Boolean @default(true)

  tuesday Boolean @default(true)

  wednesday Boolean @default(true)

  thursday Boolean @default(true)

  friday Boolean @default(true)

  saturday Boolean @default(true)

  sunday Boolean @default(true)

  active Boolean @default(true)

  createdAt DateTime @default(now())
}

model Transaction {
  id String @id @default(uuid())

  type TransactionType

  category String

  amount Float

  transactionDate DateTime

  paymentMethod PaymentMethod

  vendorId String?

  vendor Vendor? @relation(fields: [vendorId], references: [id])

  cattleId String?

  cattle Cattle? @relation(fields: [cattleId], references: [id])

  referenceNumber String?

  description String?

  createdBy String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Document {
  id String @id @default(uuid())

  fileName String

  originalName String

  mimeType String

  extension String

  size Int

  path String

  documentType DocumentType

  entityType String

  entityId String

  uploadedBy String?

  description String?

  createdAt DateTime @default(now())
}

model AuditTrail {
  id String @id @default(uuid())

  userId String?

  user User? @relation(fields: [userId], references: [id])

  entity String

  entityId String?

  action AuditAction

  oldValues String?

  newValues String?

  ipAddress String?

  description String?

  createdAt DateTime @default(now())
}

model Notification {
  id String @id @default(uuid())

  title String

  message String

  type NotificationType @default(Info)

  status NotificationStatus @default(Unread)

  entityType String?

  entityId String?

  userId String?

  user User? @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  readAt DateTime?
}
